# Contrainte de portabilité, comme CRMlead : la base n'est joignable que par cette variable.
DATABASE_URL=postgres://projectlead_owner:owner@localhost:5432/projectlead
PORT=3002
# Base des contrôles (npm test), distincte : ils créent des entreprises à chaque passage.
TEST_DATABASE_URL=postgres://projectlead_owner:owner@localhost:5432/projectlead_test
PUBLIC_URL=http://localhost:5174
# 32 caractères au moins : chiffre les secrets des boîtes mail et les clés CRMlead / InvoiceLead.
APP_SECRET=
# Envoi système (suivi client, invitations, confirmations de rendez-vous) quand aucune boîte
# n'est branchée. Sans elle, les messages sont seulement journalisés dans `sent_emails`.
SMTP_URL=
EMAIL_FROM=ProjectLead <suivi@projectlead.io>
# Compte Lead (OpenID Connect hébergé par CRMlead), voir crmlead/docs/LEAD-ID.md
LEAD_ID_ISSUER=https://crmlead.io
LEAD_ID_CLIENT_ID=projectlead
LEAD_ID_CLIENT_SECRET=
LEAD_ID_REDIRECT_URI=https://projectlead.io/auth/lead/callback
LEAD_ID_APP=projectlead
# Boîtes Gmail et Microsoft 365 (mêmes applications OAuth que CRMlead)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Protège /api/tasks/run (relances, facturation mensuelle, synchronisation des boîtes)
TASKS_SECRET=
